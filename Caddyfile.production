# ============================================================
#  生产环境 Caddy 配置: 统一入口（前端页面 + API 同源反代）
#
#  用法: 由 docker-compose.prod.yml 挂载到 /etc/caddy/Caddyfile
#        SITE_ADDRESS 从 .env 读取（必须带协议前缀）:
#          - IP:   http://42.193.101.174        （纯 HTTP, 不会 308 跳转）
#          - 域名: https://community.example.com （自动申请/续期 HTTPS 证书）
#  默认 localhost（本地开发用, Caddy 本地 CA 自签证书）
#
#  ⚠️ rate_limit 依赖 mholt/caddy-ratelimit 插件（deploy/caddy/Dockerfile 已构建）
# ============================================================
{$SITE_ADDRESS:localhost} {
	# route 保证求值顺序: 先限流、后反代
	route {
		# 登录: 每 IP 每分钟最多 10 次尝试（防暴力破解）
		rate_limit /api/auth/password/signin {
			zone signin {
				key {http.request.remote.host}
				window 1m
				events 10
			}
		}
		# 注册: 每 IP 每分钟最多 5 次尝试（防批量注册）
		rate_limit /api/auth/password/signup {
			zone signup {
				key {http.request.remote.host}
				window 1m
				events 5
			}
		}
		# API → cookie-strip（纯 HTTP 部署时去掉会话 Cookie 的 Secure 标志，否则登录无效）
		# ⚠️ 以后上 HTTPS/域名后改回 storyden:8000 直连，并删除 cookie-strip 服务
		reverse_proxy /api/* cookie-strip:8000
		# 其余（页面/静态资源）→ 前端容器
		reverse_proxy frontend:3000
	}
}
