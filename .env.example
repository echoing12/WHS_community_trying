# ============================================================
#  环境变量模板 —— 部署时复制为 .env 并填写
#    cp .env.example .env
#  ⚠️ .env 已被 .gitignore 排除，不会提交进仓库
# ============================================================

# ⚠️⚠️ 不要设置任何 NEXT_PUBLIC_* 变量！⚠️⚠️
# 前端代码使用相对路径 /api/*，由 Caddy 统一反代到 Storyden。
# 设置 NEXT_PUBLIC_API_URL 会在构建时把绝对地址内联进 JS，
# 导致浏览器跨域请求被 CORS 拦截（表现为「加载失败」）。

# ============ Storyden 后端（docker-compose.prod.yml 读取） ============

# 站点对外地址：浏览器实际访问的地址（协议必须与实际一致）
#   IP 示例：   PUBLIC_WEB_ADDRESS=http://42.193.101.174
#   域名示例：  PUBLIC_WEB_ADDRESS=https://community.example.com
PUBLIC_WEB_ADDRESS=

# API 对外地址：通常与站点地址相同
PUBLIC_API_ADDRESS=

# 会话签名密钥（必须 ≥32 字节随机值）：
#   生成命令：openssl rand -hex 32
# ⚠️ 若迁移原服务器/原机器的数据，必须沿用原 .env 里的 SESSION_KEY，
#    否则所有用户会话失效（强制登出）
SESSION_KEY=

# ============ Caddy 统一入口（docker-compose.prod.yml 读取） ============

# 站点地址（必须带协议前缀！）：
#   IP 示例：   http://42.193.101.174        （纯 HTTP；不带前缀会被 Caddy 308 跳转 HTTPS 而无法访问）
#   域名示例：  https://community.example.com （Caddy 自动申请/续期 HTTPS 证书）
SITE_ADDRESS=
