# ============================================================
#  环境变量模板（生产环境兼容）
#  复制为 .env 后按需修改；以 NEXT_PUBLIC_ 开头的变量会打包进浏览器端代码
# ============================================================

# API 基础路径（相对路径，不硬编码域名或端口 —— 生产环境兼容）
# - 开发环境：留空 ''，由 next.config.mjs 的 rewrites 代理到本地 StoryDen
# - 生产环境：留空 ''，由 Nginx 反向代理 /api/* 到 StoryDen 后端
# 仅在确有跨域需求时才填写完整地址（如 https://api.example.com）
NEXT_PUBLIC_API_URL=

# 会话 Cookie 的 secure 标志（生产环境兼容）
# - 开发环境（http://localhost）：false 或不设置
# - 生产环境（https）：必须为 true，否则浏览器拒绝保存 Cookie
# 注：真实部署下 storyden_session 由后端 Set-Cookie 下发，此开关仅影响
#     前端 mock 阶段模拟写入的 Cookie（对接真实 StoryDen 后不再需要）
NEXT_PUBLIC_COOKIE_SECURE=false

# ============ 以下是示例配置（仅作参考，按实际部署填写） ============

# StoryDen 后端配置（docker-compose.yml 使用，前端无需读取）
# PUBLIC_WEB_ADDRESS=https://community.example.com
# PUBLIC_API_ADDRESS=https://community.example.com
# SESSION_KEY=会话签名密钥（登录/注册安全加固）
#   ⚠️ 必须为 ≥32 字节的随机值（如 openssl rand -hex 32 生成），
#      严禁使用全零或短密钥（否则会话可被伪造）
#   ⚠️ 更换密钥会使所有已登录用户强制登出，请保持与现有部署一致

# 前端生产端口（默认 3000）
# PORT=3000
